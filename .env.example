# Phase 1 communications
# Phone/SMS: staff calls or texts from Google Voice and logs the interaction in the admin CRM.
# Email: staff sends from Google Workspace manually AND the intake endpoint sends ONE
#   transactional confirmation ("we received your request") via Google Workspace SMTP —
#   only when the lead provides an email and checks email consent. No marketing automation.
# See ADR: ai-context/projects/AssistedLivingHelp/decisions/0002-*.md
GMAIL_USER=help@agapaycare.com
GMAIL_APP_PASSWORD=
MAIL_FROM=Assisted Living Help <help@assistedlivinghelp.co>

# Meta lead form ingestion (future)
META_WEBHOOK_VERIFY_TOKEN=
